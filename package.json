{
  "name": "mineral-mcp",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "deploy": "npm run deploy:mcp",
    "deploy:mcp": "wrangler deploy --config apps/mcp/wrangler.jsonc",
    "deploy:vault": "wrangler deploy --config apps/vault/wrangler.jsonc",
    "deploy:vault:bootstrap": "wrangler deploy --config apps/vault/wrangler.bootstrap.jsonc",
    "dev": "npm run dev:mcp",
    "dev:mcp": "wrangler dev --config apps/mcp/wrangler.jsonc",
    "dev:vault": "wrangler dev --config apps/vault/wrangler.jsonc",
    "dev:worker": "npm run dev:mcp",
    "start": "npm run dev:mcp",
    "test": "vitest",
    "typecheck": "npm run typecheck:mcp && npm run typecheck:vault",
    "typecheck:mcp": "tsc --noEmit -p apps/mcp/tsconfig.json",
    "typecheck:vault": "tsc --noEmit -p apps/vault/tsconfig.json",
    "cf-typegen": "npm run cf-typegen:mcp && npm run cf-typegen:vault",
    "cf-typegen:mcp": "wrangler types apps/mcp/worker-configuration.d.ts --config apps/mcp/wrangler.jsonc",
    "cf-typegen:vault": "wrangler types apps/vault/worker-configuration.d.ts --config apps/vault/wrangler.jsonc",
    "inspect": "npx -y @modelcontextprotocol/inspector"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^25.6.0",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "4.135.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.11.7",
    "diff": "^9.0.0",
    "mime": "^4.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  }
}
