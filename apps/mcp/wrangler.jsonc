{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mineral-mcp",
  "main": "src/entrypoint.ts",
  "compatibility_date": "2026-04-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "services": [
    { "binding": "VAULT", "service": "mineral-vault" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "MineralMCP" },
      // Retained during the ownership-transfer rollout, but routed to the
      // target so it remains valid after this source tombstone commits.
      { "name": "VAULT_INDEX", "class_name": "VaultIndex", "script_name": "mineral-vault" }
    ]
  },
  "exports": {
    "MineralMCP": { "type": "durable-object", "storage": "sqlite" },
    "VaultIndex": {
      "type": "durable-object",
      "state": "transferred",
      "transferred_to": "mineral-vault"
    }
  },
  // The binding and source class remain during the transfer rollout; cleanup is Phase 4D.
  "r2_buckets": [
    { "binding": "MINERAL", "bucket_name": "mineral" }
  ]
}
