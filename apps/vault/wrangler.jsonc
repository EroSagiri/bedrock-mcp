{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mineral-vault",
  "main": "src/entrypoint.ts",
  "compatibility_date": "2026-04-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "triggers": { "crons": ["0 */2 * * *"] },
  "routes": [
    { "pattern": "vault.mineral.sighjune.com", "custom_domain": true }
  ],
  "r2_buckets": [
    { "binding": "MINERAL", "bucket_name": "mineral" }
  ],
  "services": [
    { "binding": "SYNC_GATEWAY", "service": "mineral-sync-gateway" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULT_INDEX",
        "class_name": "VaultIndex"
      }
    ]
  },
  "exports": {
    "VaultIndex": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "INDEXING_ENABLED": "true",
    "MINERAL_R2_ENDPOINT": "https://68b8b99e8abecd71aa2412b31c52b2b5.r2.cloudflarestorage.com",
    "MINERAL_BUCKET": "mineral",
    "MINERAL_REMOTE_PREFIX": ""
  }
}
