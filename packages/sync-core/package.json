{
  "name": "@mineral/sync-core",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "description": "Cross-repository sync control-plane contracts, channel derivation, and generation cursors.",
  "files": [
    "dist"
  ],
  "exports": {
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js",
      "default": "./dist/storage.js"
    },
    "./sync-change": {
      "types": "./dist/sync-change.d.ts",
      "import": "./dist/sync-change.js",
      "default": "./dist/sync-change.js"
    },
    "./deletion-index": {
      "types": "./dist/deletion-index.d.ts",
      "import": "./dist/deletion-index.js",
      "default": "./dist/deletion-index.js"
    },
    "./channel": {
      "types": "./dist/channel.d.ts",
      "import": "./dist/channel.js",
      "default": "./dist/channel.js"
    },
    "./gateway-protocol": {
      "types": "./dist/gateway-protocol.d.ts",
      "import": "./dist/gateway-protocol.js",
      "default": "./dist/gateway-protocol.js"
    },
    "./gateway-subscribe": {
      "types": "./dist/gateway-subscribe.d.ts",
      "import": "./dist/gateway-subscribe.js",
      "default": "./dist/gateway-subscribe.js"
    },
    "./tombstones": {
      "types": "./dist/tombstones.d.ts",
      "import": "./dist/tombstones.js",
      "default": "./dist/tombstones.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js",
      "default": "./dist/paths.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js",
      "default": "./dist/recovery.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.5.2"
  }
}
